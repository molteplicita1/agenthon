# Copy this file to .env and fill in the values. Never commit .env.

# --- Gemini (model) ---
# Leave GEMINI_API_KEY empty to use the key already exported in your shell.
GEMINI_API_KEY=
# false = AI Studio key. true = Vertex AI key (spends the Google Cloud event credits).
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_MODEL=gemini-3.8-flash

# --- ElevenLabs (voice of the morning brief) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Telegram (the bot) ---
# Token given by @BotFather after /newbot.
TELEGRAM_BOT_TOKEN=

# Where the bot finds the backend.
BACKEND_URL=http://localhost:8000
